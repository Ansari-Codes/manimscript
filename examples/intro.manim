# Text fade and a simple welcome sequence

OBJECTS:
    welcome: { object: { type: "text", text: "Welcome", font_size: 72, color: BLUE } }
    subtitle: { object: { type: "text", text: "Declarative animation", font_size: 36, color: WHITE } }

SCENE "Welcome":
    PLACE welcome AT (0, 1);
    PLACE subtitle AT (0, -1);
    FADE_IN welcome FOR 1;
    FADE_IN subtitle FOR 1.5;
    WAIT 1;
    FADE_OUT subtitle FOR 0.5;
    FADE_OUT welcome FOR 0.5;
